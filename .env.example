# ==============================================
# 🗄️ BASE DE DATOS (PostgreSQL)
# ==============================================
POSTGRES_USER="veriagent"
POSTGRES_PASSWORD="securepassword"
POSTGRES_DB="veriagent_core"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Cadena de conexión para SQLAlchemy / Prisma
DATABASE_URL="postgresql://veriagent:securepassword@localhost:5432/veriagent_core"

# ==============================================
# 🧠 INTELIGENCIA ARTIFICIAL (Estrategia Coste Cero)
# ==============================================
# Consigue estas claves GRATIS en sus respectivas webs.
# El Router rotará entre ellas automáticamente.
# Capacidad total: 120 RPM GRATIS

# 1. Groq (Prioridad 1 - 60 RPM): https://console.groq.com/keys
GROQ_API_KEY="gsk_PEGAR_TU_CLAVE_AQUI"

# 2. Cerebras (Prioridad 2 - 30 RPM): https://cloud.cerebras.ai/
CEREBRAS_API_KEY="csk_PEGAR_TU_CLAVE_AQUI"

# 3. Gemini (Prioridad 3 - 30 RPM): https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza_PEGAR_TU_CLAVE_AQUI"

# 4. OpenAI (Backup de pago - Opcional):
OPENAI_API_KEY=""

# ==============================================
# 🏛️ HACIENDA / AEAT (VeriFactu)
# ==============================================
# MOCK = Simulado local | SANDBOX = Pruebas AEAT | PROD = Real
AEAT_ENV="SANDBOX"

# Rutas a tus certificados de la FNMT
# Recuerda: .pem es obligatorio para Python/Docker
AEAT_CERT_PATH="./certs/test_cert.pem"
AEAT_KEY_PATH="./certs/test_key.pem"

# ==============================================
# 🔐 SEGURIDAD & FRONTEND (Next.js / Auth.js)
# ==============================================
# Clave aleatoria para encriptar cookies de sesión
# Genera una nueva con: openssl rand -base64 32
AUTH_SECRET="genera_una_clave_segura_con_openssl"

# URL base de tu aplicación
NEXTAUTH_URL="http://localhost:3000"

# ==============================================
# 🐳 DOCKER (Para docker-compose.yml)
# ==============================================
NEXT_PUBLIC_API_URL="http://localhost:8000"
